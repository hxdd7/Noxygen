<Window
    x:Class="Noxygen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d"
    Title="Noxygen">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="4">

                <Button 
                    x:Name="TitleBarBackButton"
                    Click="TitleBarBackButton_Click"
                    Width="40" Height="44"
                    Margin="-6 2 0 0"
                    Visibility="Collapsed"
                    Style="{StaticResource SubtleButtonStyle}"
                    VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72B;" FontSize="11"/>
                </Button>

                <Button 
                    x:Name="TitleBarPaneToggleButton"
                    Click="TitleBarPaneToggleButton_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Width="40" Height="44"
                    Padding="0"
                    Margin="-4 2 0 0"
                    VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE700;" FontSize="14"/>
                </Button>

                <Image 
                    Source="ms-appx:///Assets/Noxygen.png" 
                    Width="16" 
                    Height="16" 
                    VerticalAlignment="Center" 
                    Margin="6,0,0,0"/>

                <TextBlock 
                    Text="Noxygen" 
                    VerticalAlignment="Center" 
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    Margin="18,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Navigation Shell -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            ExpandedModeThresholdWidth="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox 
                    x:Name="NavSearchBox"
                    PlaceholderText="Search games..."
                    QueryIcon="Find"
                    TextChanged="NavSearchBox_TextChanged"
                    SuggestionChosen="NavSearchBox_SuggestionChosen"
                    QuerySubmitted="NavSearchBox_QuerySubmitted" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Library" Icon="Library" Tag="LibraryPage" />
                <NavigationViewItem Content="Statistics" Icon="Globe" Tag="StatsPage" />

                <NavigationViewItemHeader x:Name="LaunchersHeader" 
                      Content="Launchers" 
                      Visibility="Collapsed" />

                <NavigationViewItemHeader x:Name="PinnedGamesHeader" 
                      Content="Pinned Games" 
                      Visibility="Collapsed" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>