<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Noxygen.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:Noxygen.ViewModels"
    xmlns:converters="using:Noxygen.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageConverter" />
    </Page.Resources>

    <ScrollViewer Padding="20">
        <StackPanel Spacing="24">

            <!-- Header + Time Period Dropdown -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Statistics"
                           FontSize="28"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <ComboBox Grid.Column="1"
                          SelectedIndex="{x:Bind ViewModel.SelectedTimePeriod, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}"
                          MinWidth="130"
                          MaxWidth="160"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="Last Week" />
                    <ComboBoxItem Content="Last Month" />
                    <ComboBoxItem Content="Last Year" />
                    <ComboBoxItem Content="All Time" />
                </ComboBox>
            </Grid>

            <!-- Wide Layout: 4 Cards Side-by-Side -->
            <Grid x:Name="SummaryCardsWideGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Playtime" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.TotalPlaytimeFormatted, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Most Played (Period)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.PeriodFavoriteGameTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="All-Time Favorite" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.FavoriteGameTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Recorded Sessions" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.TotalSessionsCount, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Narrow Layout: 4 Cards Stacked Vertically -->
            <StackPanel x:Name="SummaryCardsNarrowStack" Spacing="10" Visibility="Collapsed">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Playtime" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalPlaytimeFormatted, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Most Played (Period)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PeriodFavoriteGameTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="All-Time Favorite" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FavoriteGameTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Recorded Sessions" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalSessionsCount, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Rolling Last-Year Playtime Heatmap + Selected Day Breakdown -->
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.HeatmapSummaryText, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Grid x:Name="HeatmapSplitGrid" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeatmapLeftCol" Width="*" />
                        <ColumnDefinition x:Name="HeatmapRightCol" Width="320" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left: Heatmap Card (Aligned Far Left) -->
                    <Border x:Name="HeatmapCard"
                            Grid.Row="0"
                            Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,18">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Area: Fixed Day Labels (Left) + Horizontally Scrolling Months & Cells (Right) -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Fixed Mon / Wed / Fri Labels aligned to 17px cells + 4px gap -->
                                <StackPanel Grid.Column="0" Margin="0,27,0,0" Spacing="4" VerticalAlignment="Top">
                                    <TextBlock Height="17" />
                                    <TextBlock Text="Mon" Height="17" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Height="17" />
                                    <TextBlock Text="Wed" Height="17" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Height="17" />
                                    <TextBlock Text="Fri" Height="17" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Height="17" />
                                </StackPanel>

                                <!-- Scrolling Months + Heatmap Grid -->
                                <ScrollViewer x:Name="HeatmapHorizontalScrollViewer"
                                              Grid.Column="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Auto"
                                              VerticalScrollMode="Disabled"
                                              ViewChanged="OnHeatmapHorizontalViewChanged">
                                    <StackPanel HorizontalAlignment="Left" Spacing="12">

                                        <!-- Rolling Month Labels (scrolls with heatmap columns) -->
                                        <ItemsRepeater HorizontalAlignment="Left"
                                                       ItemsSource="{x:Bind ViewModel.HeatmapMonths, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal" Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}"
                                                               MinWidth="17"
                                                               FontSize="11"
                                                               TextTrimming="None"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>

                                        <!-- 7-Row Heatmap Grid -->
                                        <ItemsRepeater HorizontalAlignment="Left"
                                                       ItemsSource="{x:Bind ViewModel.HeatmapDays, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout Orientation="Vertical"
                                                                   MaximumRowsOrColumns="7"
                                                                   MinRowSpacing="4"
                                                                   MinColumnSpacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:HeatmapDayCell">
                                                    <Border Width="17"
                                                            Height="17"
                                                            CornerRadius="3"
                                                            Background="{x:Bind FillBrush}"
                                                            BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                                            BorderThickness="1"
                                                            Opacity="{x:Bind CellOpacity}"
                                                            Tag="{x:Bind}"
                                                            PointerEntered="OnHeatmapCellPointerEntered"
                                                            Tapped="OnHeatmapCellTapped"
                                                            ToolTipService.ToolTip="{x:Bind TooltipText}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Fixed Footer Legend (stays anchored at bottom during horizontal scroll) -->
                            <Grid Grid.Row="1" Margin="36,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Daily playtime intensity (past 12 months)"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="Less" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,2,0" VerticalAlignment="Center" />
                                    <Border Width="13" Height="13" CornerRadius="3" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Border Width="13" Height="13" CornerRadius="3" Background="{ThemeResource SystemAccentColorDark2}" Opacity="0.55" />
                                    <Border Width="13" Height="13" CornerRadius="3" Background="{ThemeResource SystemAccentColorDark1}" Opacity="0.78" />
                                    <Border Width="13" Height="13" CornerRadius="3" Background="{ThemeResource SystemAccentColor}" Opacity="0.9" />
                                    <Border Width="13" Height="13" CornerRadius="3" Background="{ThemeResource SystemAccentColorLight1}" />
                                    <TextBlock Text="More" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- Right: Selected / Inspected Day Games List -->
                    <Border x:Name="DayDetailsCard"
                            Grid.Row="0"
                            Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18,16">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Selected Date, Today Shortcut & Total Time Header -->
                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedDayTitle, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedDaySubtitle, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="Today"
                                            Click="OnResetToTodayClicked"
                                            Visibility="{x:Bind ViewModel.ShowTodayButton, Mode=OneWay}"
                                            Padding="8,3"
                                            FontSize="11" />

                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6"
                                            Padding="8,4">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedDayTotalFormatted, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Games Played List -->
                            <ScrollViewer Grid.Row="1"
                                          MaxHeight="185"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedDayGames, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:DayGamePlayItem">
                                            <Grid Padding="10,8"
                                                  CornerRadius="6"
                                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                  ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0"
                                                      Width="28"
                                                      Height="28"
                                                      CornerRadius="5"
                                                      Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                                                    <FontIcon Glyph="&#xE7FC;" FontSize="13" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{x:Bind IconUrl, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill" />
                                                </Grid>

                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Title}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource BodyTextBlockStyle}" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind PlaytimeFormatted}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>

                            <!-- Empty Day Placeholder -->
                            <StackPanel Grid.Row="1"
                                        Visibility="{x:Bind ViewModel.IsSelectedDayEmpty, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="6"
                                        Padding="0,24">
                                <FontIcon Glyph="&#xE787;"
                                          FontSize="22"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Opacity="0.6"
                                          HorizontalAlignment="Center" />
                                <TextBlock Text="No playtime recorded"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Hover or click any square on the heatmap to inspect that day."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Top Played Leaderboard -->
            <StackPanel Spacing="12">
                <TextBlock Text="Playtime Leaderboard" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <ListView ItemsSource="{x:Bind ViewModel.TopPlayedGames, Mode=OneWay}"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:GamePlayStatItem">
                            <Grid Height="56" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Game Info (Icon + Title) -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Grid Width="36" Height="36" CornerRadius="6" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="16" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{x:Bind IconUrl, Mode=OneWay, Converter={StaticResource StringToImageConverter}}" Stretch="UniformToFill" />
                                    </Grid>

                                    <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Metrics -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SessionsFormatted}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind TotalHoursFormatted}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>