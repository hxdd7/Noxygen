<Page
    x:Class="Noxygen.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Noxygen.Models"
    xmlns:converters="using:Noxygen.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageConverter" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Command Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="Library" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
            </StackPanel>

            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton 
                    Label="Add Game" 
                    Command="{x:Bind ViewModel.AddCustomGameCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton 
                    Label="Refresh" 
                    Command="{x:Bind ViewModel.ScanForGamesCommand}"
                    IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>

                <AppBarElementContainer VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ComboBox 
                            SelectedIndex="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}"
                            Width="160"
                            VerticalAlignment="Center">
                            <ComboBoxItem Content="Name (A-Z)"/>
                            <ComboBoxItem Content="Name (Z-A)"/>
                            <ComboBoxItem Content="Size (Largest)"/>
                            <ComboBoxItem Content="Size (Smallest)"/>
                            <ComboBoxItem Content="Launcher"/>
                        </ComboBox>
                    </StackPanel>
                </AppBarElementContainer>
            </CommandBar>
        </Grid>

        <!-- Games Grid -->
        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DetectedGames, Mode=OneWay}" SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Game">
                    <Grid Width="260" Height="110" Margin="0,0,12,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="8">

                        <!-- Context Menu -->
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Edit Details" Click="ContextEditGame_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Remove Game" Click="ContextDeleteGame_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cover Art Frame -->
                        <Grid Grid.Column="0" CornerRadius="6" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE7FC;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Stretch="UniformToFill" Source="{x:Bind CoverArtUrl, Mode=OneWay, Converter={StaticResource StringToImageConverter}}" />
                        </Grid>

                        <!-- Details Panel -->
                        <Grid Grid.Column="1" Margin="12,4,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="2" Margin="8,8,8,8">
                                <TextBlock Text="{x:Bind Title}" 
                                   Style="{StaticResource BodyStrongTextBlockStyle}" 
                                   TextTrimming="CharacterEllipsis" 
                                   MaxLines="1"/>
                                <TextBlock Text="{x:Bind Company}" 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextTrimming="CharacterEllipsis" 
                                   MaxLines="1"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="8,2,8,4" Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Size Text -->
                                <TextBlock 
                                    Grid.Column="0"
                                    Text="{x:Bind DisplaySize}" 
                                    Style="{StaticResource CaptionTextBlockStyle}" 
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center"/>

                                <!-- Action Container (Play Button + Loading Ring) -->
                                <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">

                                    <!-- Play Button -->
                                    <Button 
                                        x:Name="PlayButton"
                                        Click="PlayButton_Click"
                                        Tag="{x:Bind ExecutablePath}"
                                        Width="24" 
                                        Height="24"
                                        Padding="0"
                                        ToolTipService.ToolTip="Play Game">
                                        <FontIcon Glyph="&#xE768;" FontSize="10"/>
                                    </Button>

                                    <!-- Loading Ring (Hidden by Default) -->
                                    <ProgressRing 
                                        x:Name="LoadingRing"
                                        IsActive="False"
                                        Visibility="Collapsed"
                                        Width="18"
                                        Height="18"
                                        Margin="7,3,7,3"/>

                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>