<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Noxygen.Views.SystemInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36">
        <StackPanel Spacing="24">

            <!-- Page Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="PC Information"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Hardware overview and system specifications"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4">
                    <TextBlock Text="System Online"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
            </Grid>

            <!-- Hero Device Summary Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <FontIcon Glyph="&#xE7F8;"
                                  FontSize="20"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.Info.DeviceName, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Hardware Overview Section (2x2 Grid) -->
            <StackPanel Spacing="12">
                <TextBlock Text="Hardware Overview" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Processor Card -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="PROCESSOR"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.Info.CpuShortName, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.Info.CpuSubtext, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Cores" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Info.CpuCoresText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Threads" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Info.CpuThreadsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Graphics Card -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="GRAPHICS"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.Info.GpuShortName, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.Info.GpuSubtext, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Type" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Info.DedicatedVramText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Integrated" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Info.IntegratedGpuText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Memory Card -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE964;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="MEMORY"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.Info.TotalRamShort, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.Info.MemorySubtext, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Memory Type" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Info.MemoryTypeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Installed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Info.InstalledRamText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Storage Card -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xEDA2;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="STORAGE"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.Info.StorageSummaryTitle, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.Info.StorageSubtext, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Drive count" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Info.DriveCountText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Partitions" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Info.PartitionsText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- System Monitoring Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="System Monitoring" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="18">

                        <!-- CPU Usage -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="CPU Usage" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="{x:Bind ViewModel.Info.CpuUsageText, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.Info.CpuTempText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <Grid x:Name="CpuTrackGrid"
                                  Height="6"
                                  CornerRadius="3"
                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                  SizeChanged="MonitorTrack_SizeChanged">
                                <Border x:Name="CpuFillBorder"
                                        HorizontalAlignment="Left"
                                        Width="0"
                                        CornerRadius="3"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>
                        </StackPanel>

                        <!-- Memory Usage -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Memory Usage" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Info.MemoryTotalLabel, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="{x:Bind ViewModel.Info.MemoryUsageText, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.Info.MemoryAvailableText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <Grid x:Name="MemoryTrackGrid"
                                  Height="6"
                                  CornerRadius="3"
                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                  SizeChanged="MonitorTrack_SizeChanged">
                                <Border x:Name="MemoryFillBorder"
                                        HorizontalAlignment="Left"
                                        Width="0"
                                        CornerRadius="3"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>
                        </StackPanel>

                        <!-- Integrated GPU Usage -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Integrated GPU Usage" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Info.IntegratedGpuMonitorLabel, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="{x:Bind ViewModel.Info.IntegratedGpuUsageText, Mode=OneWay}"
                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                            </Grid>
                            <Grid x:Name="IntegratedGpuTrackGrid"
          Height="6"
          CornerRadius="3"
          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
          SizeChanged="MonitorTrack_SizeChanged">
                                <Border x:Name="IntegratedGpuFillBorder"
                HorizontalAlignment="Left"
                Width="0"
                CornerRadius="3"
                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>
                        </StackPanel>

                        <!-- Dedicated GPU Usage -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Dedicated GPU Usage" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Info.DedicatedGpuMonitorLabel, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="{x:Bind ViewModel.Info.DedicatedGpuUsageText, Mode=OneWay}"
                   Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.Info.GpuVramLabel, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <Grid x:Name="DedicatedGpuTrackGrid"
          Height="6"
          CornerRadius="3"
          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
          SizeChanged="MonitorTrack_SizeChanged">
                                <Border x:Name="DedicatedGpuFillBorder"
                HorizontalAlignment="Left"
                Width="0"
                CornerRadius="3"
                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- System Details Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="System Details" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20,14">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="Operating System" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Info.OperatingSystemDetail, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid>
                            <TextBlock Text="Architecture" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Info.ArchitectureDetail, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid>
                            <TextBlock Text="DirectX" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Info.DirectXDetail, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid>
                            <TextBlock Text="System Firmware" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Info.FirmwareDetail, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid>
                            <TextBlock Text="Display Adapter" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Info.DisplayAdapterDetail, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid>
                            <TextBlock Text="Computer Name" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Info.ComputerNameDetail, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Noxygen System Information"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="1"
                                 Command="{x:Bind ViewModel.RefreshCommand}"
                                 Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh data" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </HyperlinkButton>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>